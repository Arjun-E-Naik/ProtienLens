# Secrets & Local Environment (NEVER COMMIT)
.env
*.env
backend/.env
frontend/.env*
!.env.example
!backend/.env.example

# Local SQLite Databases & Runtime Data
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# Python

*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node.js / Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
npm-debug.log*

# OS & Editor artifacts
.DS_Store
Thumbs.db
*.log
